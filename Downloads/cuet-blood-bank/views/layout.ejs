<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · ' + appName : appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="pulse-rail" aria-hidden="true">
    <svg viewBox="0 0 400 40" preserveAspectRatio="none">
      <path class="pulse-path" d="M0,20 L120,20 L135,4 L150,36 L165,20 L400,20" />
    </svg>
  </div>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 2C12 2 4 11.2 4 16a8 8 0 0 0 16 0C20 11.2 12 2 12 2z" fill="currentColor"/></svg>
        </span>
        <span class="brand-text">CUET<strong>Blood</strong>Bank</span>
      </a>
      <nav class="main-nav">
        <a href="/search" class="<%= currentPath === '/search' ? 'active' : '' %>">Find Blood</a>
        <a href="/requests" class="<%= currentPath === '/requests' ? 'active' : '' %>">Requests</a>
        <a href="/requests/new" class="nav-cta-outline">Request Blood</a>
        <% if (typeof donor !== 'undefined' && donor) { %>
          <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a>
          <a href="/logout" class="nav-cta">Log Out</a>
        <% } else { %>
          <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>">Log In</a>
          <a href="/register" class="nav-cta">Become a Donor</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <span class="brand-text small">CUET<strong>Blood</strong>Bank</span>
        <p>A donor network run by and for Chittagong University of Engineering &amp; Technology students. Always confirm blood compatibility with the hospital blood bank.</p>
      </div>
      <div class="footer-links">
        <a href="/search">Find Blood</a>
        <a href="/requests/new">Request Blood</a>
        <a href="/register">Become a Donor</a>
      </div>
    </div>
  </footer>

  <dialog class="contact-dialog" data-contact-dialog aria-labelledby="contact-dialog-title">
    <form method="dialog" class="dialog-close-row">
      <button class="icon-button" aria-label="Close contact request">&times;</button>
    </form>
    <div class="dialog-kicker">PRIVACY-PROTECTED CONTACT</div>
    <h2 id="contact-dialog-title">Request donor contact</h2>
    <p>Tell the donor why you need to reach them. Your details will be recorded in their dashboard.</p>
    <form data-contact-form>
      <div class="field">
        <label for="contact-requester-name">Your name</label>
        <input id="contact-requester-name" name="requesterName" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="contact-requester-phone">Your phone number</label>
        <input id="contact-requester-phone" name="requesterPhone" type="tel" required autocomplete="tel" />
      </div>
      <div class="field">
        <label for="contact-reason">Why do you need to contact this donor?</label>
        <textarea id="contact-reason" name="reason" maxlength="300" required placeholder="Example: urgent A+ blood request at CUET Medical Centre"></textarea>
      </div>
      <p class="dialog-status" data-contact-status aria-live="polite"></p>
      <button class="btn btn-primary btn-block" type="submit" data-contact-submit>Request contact details</button>
    </form>
  </dialog>

  <script src="/js/main.js"></script>
</body>
</html>
