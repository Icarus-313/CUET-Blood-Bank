<section class="block form-shell">
  <div class="wrap" style="max-width:480px;">
    <div class="section-head" style="display:block;">
      <h2>Log in</h2>
      <p>Access your donor dashboard.</p>
    </div>
    <div class="form-panel">
      <% if (errors && errors.length) { %>
        <div class="form-errors"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <% } %>
      <form method="POST" action="/login">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= old.email || '' %>" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </form>
      <div class="form-note">New here? <a href="/register">Register as a donor</a></div>
    </div>
  </div>
</section>
