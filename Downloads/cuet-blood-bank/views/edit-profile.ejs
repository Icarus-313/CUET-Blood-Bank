<section class="block form-shell">
  <div class="wrap" style="max-width:560px;">
    <div class="section-head" style="display:block;">
      <h2>Edit profile</h2>
      <p>Your email can't be changed here — contact an admin if it's wrong.</p>
    </div>
    <div class="form-panel">
      <% if (errors && errors.length) { %>
        <div class="form-errors"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <% } %>
      <form method="POST" action="/profile/edit">
        <div class="field">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" value="<%= donor.name %>" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" value="<%= donor.phone %>" required />
          </div>
          <div class="field">
            <label for="bloodGroup">Blood group</label>
            <select id="bloodGroup" name="bloodGroup" required>
              <% bloodGroups.forEach(bg => { %>
                <option value="<%= bg %>" <%= donor.bloodGroup === bg ? 'selected' : '' %>><%= bg %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="department">Department</label>
            <input type="text" id="department" name="department" value="<%= donor.department %>" />
          </div>
          <div class="field">
            <label for="batch">Batch</label>
            <input type="text" id="batch" name="batch" value="<%= donor.batch %>" />
          </div>
        </div>
        <div class="field">
          <label for="addressLabel">Usual location</label>
          <input type="text" id="addressLabel" name="addressLabel" value="<%= donor.addressLabel %>" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Save changes</button>
      </form>
      <div class="form-note"><a href="/dashboard">&larr; Back to dashboard</a></div>
    </div>
  </div>
</section>
