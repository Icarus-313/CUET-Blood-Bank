# Server
PORT=3000
NODE_ENV=development
APP_NAME=CUET Blood Bank
APP_URL=http://localhost:3000

# MongoDB
# Local:      mongodb://127.0.0.1:27017/cuet_blood_bank
# Atlas (recommended, free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cuet_blood_bank
MONGO_URI=mongodb://127.0.0.1:27017/cuet_blood_bank

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
COOKIE_NAME=bb_token

# Only emails ending in this domain can register/login as donors.
# CUET's real student mail domain is @student.cuet.ac.bd — adjust if yours differs.
ALLOWED_EMAIL_DOMAIN=student.cuet.ac.bd

# Email (Nodemailer via SMTP). Gmail example: use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="CUET Blood Bank <your_email@gmail.com>"

# Donor search: default radius (km) used when a receiver searches "nearby"
DEFAULT_SEARCH_RADIUS_KM=10

# Minimum days that must pass since last donation before a donor is shown as "eligible"
DONATION_ELIGIBILITY_DAYS=90
