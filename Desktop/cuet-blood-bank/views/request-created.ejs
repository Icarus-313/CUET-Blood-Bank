<section class="plain-page">
  <div class="wrap" style="max-width:560px;">
    <div class="eyebrow" style="justify-content:center;"><span class="dot"></span> REQUEST SUBMITTED</div>
    <h2>Your request for <span class="mono"><%= bloodRequest.bloodGroup %></span> blood is live.</h2>
    <% if (bloodRequest.urgency === 'urgent') { %>
      <p><%= notifiedCount %> eligible donor<%= notifiedCount === 1 ? '' : 's' %> matching <%= bloodRequest.bloodGroup %> <%= notifiedCount === 1 ? 'has' : 'have' %> been emailed nearby.</p>
    <% } else { %>
      <p>Your request now appears in the open requests list. Mark it urgent next time to notify donors by email immediately.</p>
    <% } %>
    <div class="hero-actions" style="justify-content:center;">
      <a href="/requests" class="btn btn-primary">View open requests</a>
      <a href="/search" class="btn btn-outline">Search donors yourself</a>
    </div>
  </div>
</section>
