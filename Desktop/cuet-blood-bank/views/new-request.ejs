<section class="block form-shell">
  <div class="wrap" style="max-width:620px;">
    <div class="section-head" style="display:block;">
      <h2>Request blood</h2>
      <p>Anyone can submit a request. Mark it <strong>urgent</strong> to instantly email every eligible, matching donor nearby.</p>
    </div>

    <div class="form-panel">
      <% if (errors && errors.length) { %>
        <div class="form-errors"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <% } %>

      <form method="POST" action="/requests/new">
        <div class="field-row">
          <div class="field">
            <label for="requesterName">Your name</label>
            <input type="text" id="requesterName" name="requesterName" value="<%= old.requesterName || '' %>" required />
          </div>
          <div class="field">
            <label for="requesterPhone">Your phone</label>
            <input type="tel" id="requesterPhone" name="requesterPhone" value="<%= old.requesterPhone || '' %>" required />
          </div>
        </div>
        <div class="field">
          <label for="requesterEmail">Your email (optional)</label>
          <input type="email" id="requesterEmail" name="requesterEmail" value="<%= old.requesterEmail || '' %>" />
        </div>
        <div class="field">
          <label for="patientName">Patient name (optional)</label>
          <input type="text" id="patientName" name="patientName" value="<%= old.patientName || '' %>" />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="bloodGroup">Blood group needed</label>
            <select id="bloodGroup" name="bloodGroup" required>
              <option value="">Select</option>
              <% bloodGroups.forEach(bg => { %>
                <option value="<%= bg %>" <%= old.bloodGroup === bg ? 'selected' : '' %>><%= bg %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="unitsNeeded">Units needed</label>
            <input type="number" id="unitsNeeded" name="unitsNeeded" min="1" value="<%= old.unitsNeeded || 1 %>" />
          </div>
        </div>
        <div class="field">
          <label for="hospital">Hospital / location name</label>
          <input type="text" id="hospital" name="hospital" placeholder="CUET Medical Centre" value="<%= old.hospital || '' %>" />
        </div>
        <div class="field">
          <label for="addressLabel">Area / address (optional)</label>
          <input type="text" id="addressLabel" name="addressLabel" value="<%= old.addressLabel || '' %>" />
        </div>

        <div class="location-box">
          <div>
            <div style="font-weight:600;font-size:0.9rem;">Attach precise location</div>
            <p class="location-status" data-request-location-status style="margin:2px 0 0;">Helps us find the nearest eligible donors.</p>
          </div>
          <button type="button" class="btn btn-outline btn-sm" data-capture-request-location>Use my location</button>
        </div>
        <input type="hidden" id="req-lat" name="lat" />
        <input type="hidden" id="req-lng" name="lng" />

        <div class="field">
          <label for="reason">Additional context (optional)</label>
          <textarea id="reason" name="reason"><%= old.reason || '' %></textarea>
        </div>

        <div class="field">
          <label>Urgency</label>
          <div class="radio-pills">
            <div class="radio-pill">
              <input type="radio" id="urgency-normal" name="urgency" value="normal" <%= old.urgency !== 'urgent' ? 'checked' : '' %> />
              <label for="urgency-normal">Normal</label>
            </div>
            <div class="radio-pill">
              <input type="radio" id="urgency-urgent" name="urgency" value="urgent" <%= old.urgency === 'urgent' ? 'checked' : '' %> />
              <label for="urgency-urgent">Urgent — email donors now</label>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Submit request</button>
      </form>
    </div>
  </div>
</section>
